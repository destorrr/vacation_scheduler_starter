APP_NAME=Vacation Scheduler
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
DEBUG=false
SESSION_HTTPS_ONLY=false
SESSION_MAX_AGE=28800
POSTGRES_DB=vacation
POSTGRES_USER=vacation
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://vacation:replace-with-a-strong-database-password@db:5432/vacation
STORAGE_PATH=/storage
