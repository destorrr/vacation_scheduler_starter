APP_NAME=Vacation Scheduler
# Generate a unique value: openssl rand -hex 32
SECRET_KEY=replace-with-a-unique-random-secret-generated-by-openssl-rand-hex-32
DEBUG=false
# Keep true when HTTPS is terminated by the external reverse proxy.
SESSION_HTTPS_ONLY=true
SESSION_MAX_AGE=28800

POSTGRES_DB=vacation
POSTGRES_USER=vacation
# Use a strong password without URL-reserved characters (for example, hex output).
POSTGRES_PASSWORD=replace-with-a-unique-random-database-password

STORAGE_PATH=/storage
